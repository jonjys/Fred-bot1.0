{
  "prod_lock": "PROD LOCK v1",
  "strategy": "FredbV2ProdStrategy",
  "dry_run": true,
  "max_open_trades": 3,
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.95,
  "available_capital": 1000,
  "telegram": {
    "enabled": false,
    "notification_settings": {
      "status": "on",
      "warning": "on",
      "startup": "on",
      "entry": "on",
      "entry_fill": "on",
      "exit": "on",
      "exit_fill": "on",
      "protection_trigger": "on"
    }
  },
  "webhook": {
    "enabled": false,
    "url": "",
    "format": "json",
    "entry_fill": {"event": "entry_fill", "pair": "{pair}", "rate": "{open_rate:8f}", "stake": "{stake_amount:8f}"},
    "exit_fill": {"event": "exit_fill", "pair": "{pair}", "profit_ratio": "{profit_ratio:8f}", "reason": "{exit_reason}"},
    "status": {"event": "status", "message": "{status}"}
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "enable_openapi": false
  }
}
